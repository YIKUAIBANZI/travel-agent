# 小红书 Cookie（F12 → Application → Cookies → xiaohongshu.com）
XHS_COOKIE_A1=
XHS_COOKIE_WEB_SESSION=
XHS_COOKIE_WEB_ID=

# 高德地图 API Key（免费申请: https://lbs.amap.com/）
AMAP_API_KEY=

# 爬虫速率（秒）
SCRAPER_DELAY_MIN=1.5
SCRAPER_DELAY_MAX=3.5

# 数据目录
DATA_DIR=data/raw

# XHS 模式: api | connected（推荐）| browser
XHS_MODE=connected

# LLM 配置（支持任何 OpenAI 兼容 API）
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
# Claude:     LLM_BASE_URL=https://api.anthropic.com/v1     LLM_MODEL=claude-sonnet-4-20250514
# Deepseek:   LLM_BASE_URL=https://api.deepseek.com/v1     LLM_MODEL=deepseek-chat
# 通义:       LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 清洗后数据目录
CLEANED_DIR=data/cleaned

# Exa 网络搜索（可选）
# 申请：https://exa.ai/  → API Keys
# 不填则跳过网络攻略，仅用本地预爬数据
EXA_API_KEY=
